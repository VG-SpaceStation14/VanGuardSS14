language-Universal-name = Universal
language-Universal-description = WHAT ARE YOU.

language-GalacticCommon-name = Galactic Common
language-GalacticCommon-description = Usually used for cross-species communication and official purposes. Available for learning and reproduction by most sapient species in the galaxy.

language-Arachnid-name = Arachnid
language-Arachnid-description = Hissing chirps used by arachnids and spiders.

language-Nekomimetic-name = Nekomimetic
language-Nekomimetic-description = To an outsider this language sounds like broken Japanese. Felines somehow understand it.

language-Draconic-name = Sinta'Unathi
language-Draconic-description = The common language of the reptilians with various dialects and writing systems. It consists mostly of fricative and glottal consonants with almost no labial sounds.

language-Canilunzt-name = Canilunzt
language-Canilunzt-description = A guttural language used by the inhabitants of the Vazzend system, full of growls, barks, yips and intense ear and tail motion.

language-SikTaj-name = Siik'Tajr
language-SikTaj-description = The language spoken by the inhabitants of the Adhomai system.

language-RootSpeak-name = Rootspeak
language-RootSpeak-description = The strange language of dionae, made of rustling, creaking and crackling sounds.

language-Bubblish-name = Bubblish
language-Bubblish-description = The language of slime people, a mix of bubbling sounds and gurgles.

language-VoxPidgin-name = Vox Pidgin
language-VoxPidgin-description = A mix of chirps and shrieks, hard to understand for other species due to its ultrasonic characteristics.

language-RobotTalk-name = Robot Talk
language-RobotTalk-description = The rhythmic language of positronic units. Staccato tones and synthesized sounds.

language-Dwarf-name = Dwarven
language-Dwarf-description = A miner's tongue full of rock and ale.

language-Gutter-name = Gutter
language-Gutter-description = An officially unrecognized pidgin combining elements of various languages, popular among fringe groups and pirates.

language-Clownish-name = Clownish
language-Clownish-description = Clown language! Honk!

language-SignLanguage-name = Sign Language
language-SignLanguage-description = A language that allows deaf members of various species to communicate with each other.

language-Cat-name = Cat
language-Cat-description = The language of cats: purring, meowing and murmuring.

language-Dog-name = Dog
language-Dog-description = The language of dogs: barking and growling.

language-Turtle-name = Turtle
language-Turtle-description = Slow hissing and clicking sounds of turtles.

language-Pigeon-name = Pigeon
language-Pigeon-description = Cooing of pigeons.

language-Goat-name = Goat
language-Goat-description = Bleating and snorting of goats.

language-Xeno-name = Xeno
language-Xeno-description = Hissing and clicking of xenomorphs.

language-Monkey-name = Monkey
language-Monkey-description = Guttural sounds of monkeys.

language-Dragon-name = Dragon
language-Dragon-description = Roaring of dragons.

language-Bee-name = Bee
language-Bee-description = Buzzing of bees.

language-Mouse-name = Mouse
language-Mouse-description = Squeaking of mice.

language-Chicken-name = Chicken
language-Chicken-description = Clucking of chickens.

language-Duck-name = Duck
language-Duck-description = Quacking of ducks.

language-Cow-name = Cow
language-Cow-description = Mooing of cows.

language-Pig-name = Pig
language-Pig-description = Oinking of pigs.

language-Sheep-name = Sheep
language-Sheep-description = Bleating of sheep.

language-CodeSpeak-name = Code Speak
language-CodeSpeak-description = Syndicate operatives use a series of codewords to convey complex information.

language-Dev-name = Dev
language-Dev-description = Sounds more like swearing covered in code than a language.
