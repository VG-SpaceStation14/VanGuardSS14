ent-RPD = РТУ
    .desc = Новейшее ручное трубопроводное устройство, которое может быстро размещать и демонтировать атмосферные и утилизационные коммуникации. Требует сжатой материи для использования.
ent-RPDEmpty = { ent-RPD }
    .desc = { ent-RPD.desc }
    .suffix = Пустой
ent-RPDRecharging = экспериментальный РТУ
    .desc = РТУ с блюспейс-улучшением, пассивно генерирующий собственную сжатую материю.
    .suffix = Автозарядка

### Интерфейс

rpd-component-examine-mode-details = Выбран режим: '{ $mode }'.
rpd-component-examine-build-details = Выбран режим строительства: { $name }.
### Сообщения при взаимодействии

# Смена мода
rpd-component-change-mode = РТУ переключён в режим '{ $mode }'.
rpd-component-change-build-mode = РТУ переключён в режим строительства. Строится { $name }.
# Кол-во материи
rpd-component-no-ammo-message = В РТУ закончились заряды!
rpd-component-insufficient-ammo-message = В РТУ не хватает зарядов!
# Разборка
rpd-component-deconstruct-target-not-on-whitelist-message = Вы не можете демонтировать это!
rpd-component-nothing-to-deconstruct-message = Здесь нечего демонтировать!
# Строительство
rpd-component-cannot-build-on-empty-tile-message = Это не может быть построено без фундамента.
rpd-component-must-build-on-subfloor-message = Это может быть построено только на покрытии!
rpd-component-cannot-build-on-occupied-tile-message = Здесь нельзя строить, место уже занято!

