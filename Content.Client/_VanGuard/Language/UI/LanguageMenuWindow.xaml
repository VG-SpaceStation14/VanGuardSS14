<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'language-menu-window-title'}"
    MinSize="460 520"
    SetSize="460 520">
    <BoxContainer
        Orientation="Vertical"
        VerticalExpand="True"
        HorizontalExpand="True"
        SeparationOverride="6"
        Margin="10">
        <PanelContainer StyleClasses="PanelInsetDark">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4">
                <Label
                    Name="CurrentLanguageLabel"
                    StyleClasses="LabelHeading"/>
                <Label
                    Name="LanguagesCountLabel"
                    StyleClasses="LabelSubText"/>
            </BoxContainer>
        </PanelContainer>
        <LineEdit
            Name="SearchBar"
            PlaceHolder="{Loc 'language-menu-search-placeholder'}"/>
        <ScrollContainer
            VerticalExpand="True"
            HorizontalExpand="True"
            HScrollEnabled="False">
            <BoxContainer
                Name="OptionsList"
                Orientation="Vertical"
                VerticalExpand="True"
                HorizontalExpand="True"
                SeparationOverride="6"/>
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
