<DefaultWindow xmlns="https://spacestation14.io"
               Title="Привязка Discord"
               MinSize="400 300"
               Resizable="False">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="10">
        
        <BoxContainer Name="UnlinkedState" Orientation="Vertical" SeparationOverride="10">
            <Label Text="Вы не привязали Discord" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
            <Label Text="Нажмите кнопку ниже, чтобы получить код, затем введите его в Discord-боте командой /link." HorizontalAlignment="Center"/>
            <Button Name="GetCodeButton" Text="Получить код" StyleClasses="ButtonBig" Margin="0 10 0 0"/>
        </BoxContainer>

        <BoxContainer Name="WaitingState" Orientation="Vertical" Visible="False">
            <Label Text="Генерация кода, подождите..." StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
        </BoxContainer>

        <BoxContainer Name="CodeState" Orientation="Vertical" SeparationOverride="10" Visible="False">
            <Label Text="Ваш код для ввода в Discord:" HorizontalAlignment="Center"/>
            <Label Name="CodeLabel" StyleClasses="LabelHeadingBigger" HorizontalAlignment="Center" FontColorOverride="#4CAF50"/>
            <Button Name="CopyButton" Text="Скопировать код" />
            <Button Name="OpenDiscordButton" Text="Открыть Discord" StyleClasses="ButtonBig" Margin="0 10 0 0"/>
        </BoxContainer>

        <BoxContainer Name="LinkedState" Orientation="Vertical" SeparationOverride="10" Visible="False">
            <Label Text="Discord успешно привязан!" StyleClasses="LabelHeading" HorizontalAlignment="Center" FontColorOverride="#4CAF50"/>
            <Label Name="TierLabel" StyleClasses="LabelBig" HorizontalAlignment="Center"/>
            <Label Name="TimeLeftLabel" StyleClasses="LabelSubText" HorizontalAlignment="Center"/>
            <Button Name="OpenDiscordLinkedButton" Text="Открыть Discord" Margin="0 10 0 0"/>
            <Label Text="Чтобы отвязать аккаунт, введите /unlink в Discord-боте." StyleClasses="LabelSubText" HorizontalAlignment="Center" Margin="0 10 0 0"/>
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
