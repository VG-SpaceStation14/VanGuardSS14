<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'discord-link-window-title'}"
               MinSize="400 300"
               Resizable="False">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="10">
        
        <BoxContainer Name="UnlinkedState" Orientation="Vertical" SeparationOverride="10">
            <Label Text="{Loc 'discord-link-unlinked-title'}" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
            <Label Text="{Loc 'discord-link-unlinked-desc'}" HorizontalAlignment="Center"/>
            <Button Name="GetCodeButton" Text="{Loc 'discord-link-get-code'}" StyleClasses="ButtonBig" Margin="0 10 0 0"/>
        </BoxContainer>

        <BoxContainer Name="WaitingState" Orientation="Vertical" Visible="False">
            <Label Text="{Loc 'discord-link-waiting'}" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
        </BoxContainer>

        <BoxContainer Name="CodeState" Orientation="Vertical" SeparationOverride="10" Visible="False">
            <Label Text="{Loc 'discord-link-code-desc'}" HorizontalAlignment="Center"/>
            <Label Name="CodeLabel" StyleClasses="LabelHeadingBigger" HorizontalAlignment="Center" FontColorOverride="#4CAF50"/>
            <Button Name="CopyButton" Text="{Loc 'discord-link-copy-code'}" />
            <Button Name="OpenDiscordButton" Text="{Loc 'discord-link-open-discord'}" StyleClasses="ButtonBig" Margin="0 10 0 0"/>
        </BoxContainer>

        <BoxContainer Name="LinkedState" Orientation="Vertical" SeparationOverride="10" Visible="False">
            <Label Text="{Loc 'discord-link-success-title'}" StyleClasses="LabelHeading" HorizontalAlignment="Center" FontColorOverride="#4CAF50"/>
            <Label Name="TierLabel" StyleClasses="LabelBig" HorizontalAlignment="Center"/>
            <Label Name="TimeLeftLabel" StyleClasses="LabelSubText" HorizontalAlignment="Center"/>
            <Button Name="OpenDiscordLinkedButton" Text="{Loc 'discord-link-open-discord'}" Margin="0 10 0 0"/>
            <Label Text="{Loc 'discord-link-unlink-desc'}" StyleClasses="LabelSubText" HorizontalAlignment="Center" Margin="0 10 0 0"/>
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
