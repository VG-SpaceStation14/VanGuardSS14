<controls:FancyWindow xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
         xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         SetSize="900 700"
         MinSize="760 480"
         Resizable="False">
    <BoxContainer Orientation="Horizontal" VerticalExpand="True">
        <!-- Species list -->
        <ScrollContainer Name="SpeciesScroll"
                         HorizontalExpand="True" VerticalExpand="True"
                         HScrollEnabled="False" Margin="5" MinWidth="220">
            <PanelContainer VerticalExpand="True" HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
                </PanelContainer.PanelOverride>
                <BoxContainer Name="SpeciesList" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True"/>
            </PanelContainer>
        </ScrollContainer>
        <!-- Details -->
        <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="5" HorizontalExpand="True" MinWidth="460">
            <BoxContainer Orientation="Horizontal" VerticalAlignment="Top">
                <PanelContainer SetSize="180 180" MaxSize="180 180" VerticalAlignment="Top" Margin="5">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <profile:ProfilePreviewSpriteView Name="NakedPreview" Scale="4 4"/>
                </PanelContainer>
                <PanelContainer SetSize="180 180" MaxSize="180 180" VerticalAlignment="Top" Margin="5">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <profile:ProfilePreviewSpriteView Name="UniformPreview" Scale="4 4"/>
                </PanelContainer>
            </BoxContainer>
            <Button Name="ChooseButton" Text="{Loc 'species-window-choose'}" SetWidth="370" MinWidth="370"/>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" Margin="5">
                <PanelContainer VerticalExpand="True" HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Name="Details" Orientation="Vertical" MaxWidth="380" VerticalExpand="True"/>
                </PanelContainer>
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
