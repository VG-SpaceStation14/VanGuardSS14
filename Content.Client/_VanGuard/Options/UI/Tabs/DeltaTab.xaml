<tabs:DeltaTab xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:tabs="clr-namespace:Content.Client._VanGuard.Options.UI.Tabs">
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
        <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True" SeparationOverride="6">
            <Label Text="{Loc 'ui-options-general-forknotice'}"
                   StyleClasses="LabelKeyText" />

            <BoxContainer Orientation="Vertical" SeparationOverride="2">
                <Label Text="{Loc 'ui-options-quality-label'}"
                       StyleClasses="LabelKeyText" />
                <CheckBox Name="DisableBloomCheckBox" Text="{Loc 'ui-options-bloom'}" />
            </BoxContainer>

            <BoxContainer Orientation="Vertical" SeparationOverride="2">
                <Label Text="{Loc 'ui-options-header-ui'}"
                       StyleClasses="LabelKeyText" />
                <CheckBox Name="PointingChatSpritesCheckBox" Text="{Loc 'ui-options-pointing-chat-sprites'}" />
            </BoxContainer>
        </BoxContainer>

        <controls:StripeBack HasBottomEdge="False" HasMargins="False">
            <Button Name="ApplyButton"
                    Text="{Loc 'ui-options-apply'}"
                    TextAlign="Center"
                    HorizontalAlignment="Right" />
        </controls:StripeBack>
    </BoxContainer>
</tabs:DeltaTab>
