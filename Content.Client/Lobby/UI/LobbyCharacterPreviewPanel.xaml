<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls">
    <BoxContainer Name="VBox" Orientation="Vertical">
        <PanelContainer MinHeight="24">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#0A0E12"
                                       BorderColor="#FF6A00"
                                       BorderThickness="0 0 0 2" />
            </PanelContainer.PanelOverride>
            <Label Text="{Loc 'lobby-character-preview-panel-header'}"
                   StyleClasses="LabelSubText"
                   Margin="10 4" VerticalAlignment="Center" />
        </PanelContainer>

        <BoxContainer Name="Loaded" Orientation="Vertical" Visible="False">
            <RichTextLabel Name="Summary" HorizontalAlignment="Center" Margin="3 3"
                           MaxWidth="280"/>
            <BoxContainer Name="CharacterSelectorRow" Orientation="Horizontal"
                          HorizontalAlignment="Center" Margin="3 5">
                <Button Name="LeftCharacterButton" MinSize="90 120" Visible="False"
                        StyleClasses="OpenRight" Margin="0 0 2 0" VerticalAlignment="Center" />
                <PanelContainer Name="CenterCharacterPanel" MinSize="112 140" StyleClasses="AngleRect">
                    <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <BoxContainer Name="ViewBox" Orientation="Horizontal" HorizontalAlignment="Center">
                            <profile:ProfilePreviewSpriteView Name="ProfilePreviewSpriteView"
                                                              OverrideDirection="South"
                                                              Scale="4 4"
                                                              MaxSize="112 112"
                                                              Stretch="Fill"
                                                              Access="Public" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
                <Button Name="RightCharacterButton" MinSize="90 120" Visible="False"
                        StyleClasses="OpenLeft" Margin="2 0 0 0" VerticalAlignment="Center" />
            </BoxContainer>
            <controls:VSpacer/>
        </BoxContainer>
        <Label Name="Unloaded"
               Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center" Margin="6" />
    </BoxContainer>
</Control>